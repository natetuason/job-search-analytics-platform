# Copy to .env and fill in. .env is git-ignored; never commit real values.

POSTGRES_USER=jobs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobs
POSTGRES_PORT=5432

# Used by the API and Alembic. Host is "localhost" when running on your Mac,
# docker-compose overrides it to "db" inside containers.
DATABASE_URL=postgresql+psycopg://jobs:change-me@localhost:5432/jobs
# Separate database for pytest (created automatically by the test suite).
TEST_DATABASE_URL=postgresql+psycopg://jobs:change-me@localhost:5432/jobs_test

LOG_LEVEL=INFO

# Later phases
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=job-platform/0.1 (personal use)
# ANTHROPIC_API_KEY=

# Adzuna API: https://developer.adzuna.com (personal job search)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
